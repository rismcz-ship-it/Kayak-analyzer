# Hermes agent internals (not part of school project)
.hermes/

# OpenCode agent internals — the agent's own GENERAL-purpose skills, not this
# project's. The project-scoped packs under .opencode/skills/ (threejs-*,
# computational-geometry, naval-architect) are deliberately tracked and
# documented in AGENTS.md as vendored third-party content (MIT), so ignore the
# general packs by name and never the directory: a blanket .opencode/ rule
# contradicts 61 tracked files, and a future project-scoped pack would be
# silently ignored the first time it landed here.
.opencode/skills/frontend-design/
.opencode/skills/unslop/

# Third-party transcripts kept for reference only (YouTube downloads).
# They are other people's content and do not belong in this repository.
docs/kole-jain-transcripts/

# Superpowers plan workspaces (inline-execution scratch, likes .gitkeep-free)
.superpowers/

# Node / Vite
node_modules/
dist/
dist-ssr/
*.local

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# Environment / secrets
.env

# Local dev scripts (wizard-generated)
scripts/
check-mesh.ts

# Local uploads / test artifacts (keep repo small)
uploads/
*.stl
!sample_data/*.stl
# Test fixtures must be committed: the verification suites read them at import
# time, so a fresh clone has to contain them or it verifies nothing. The
# re-inclusion has to cover every fixture folder, not just tests/, or a new
# fixture is silently ignored and the suite fails at import for no visible
# reason.
!tests/**/*.stl
!fixtures/**/*.stl
