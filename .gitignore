# Hermes agent internals (not part of school project)
.hermes/

# Superpowers plan workspaces (inline-execution scratch, likes .gitkeep-free)
.superpowers/

# Node / Vite
node_modules/
dist/
dist-ssr/
*.local

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# Environment / secrets
.env

# Local dev scripts (wizard-generated)
scripts/
check-mesh.ts

# Local uploads / test artifacts (keep repo small)
uploads/
*.stl
!sample_data/*.stl
# Test fixtures must be committed: the verification suites read them at import
# time, so a fresh clone has to contain them or it verifies nothing. The
# re-inclusion has to cover every fixture folder, not just tests/, or a new
# fixture is silently ignored and the suite fails at import for no visible
# reason.
!tests/**/*.stl
!fixtures/**/*.stl
