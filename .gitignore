# Hermes agent internals (not part of school project)
.hermes/

# Superpowers plan workspaces (inline-execution scratch, likes .gitkeep-free)
.superpowers/

# Node / Vite
node_modules/
dist/
dist-ssr/
*.local

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# Environment / secrets
.env

# Local dev scripts (wizard-generated)
scripts/deploy-wizard.sh
scripts/reset-to-commit.sh
check-mesh.ts

# Local uploads / test artifacts (keep repo small)
uploads/
*.stl
!sample_data/*.stl
# The verification suites need this mesh — without it they abort at import.
# It has to live in the repo or a fresh clone verifies nothing.
!tests/*.stl
