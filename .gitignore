# Hermes agent internals (not part of school project)
.hermes/

# Node / Vite
node_modules/
dist/
dist-ssr/
*.local

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# Environment / secrets
.env

# Local dev scripts (wizard-generated)
scripts/deploy-wizard.sh
scripts/reset-to-commit.sh
check-mesh.ts

# Local uploads / test artifacts (keep repo small)
uploads/
*.stl
!sample_data/*.stl
# The regression suite needs this mesh. Six tests (test-auto-orient,
# test-solver, verify-coefficients, verify-decimation, verify-heel-real,
# verify-trim-search) cannot run at all without it, so it has to live in the
# repo or a fresh clone verifies nothing.
!tests/*.stl
